# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Cloud Storage
GCS_BUCKET_NAME=your-bucket-name
GCS_RAW_PREFIX=raw/
GCS_RESULTS_PREFIX=results/
GCS_CHECKPOINTS_PREFIX=checkpoints/

# BigQuery
BQ_DATASET=palimpsest_results
BQ_TABLE=change_detections

# Artifact Registry
AR_REPOSITORY=palimpsest-repo
AR_IMAGE_NAME=palimpsest-api

# Earth Engine
EE_PROJECT=your-ee-project-id

# Model
MODEL_CHECKPOINT_PATH=checkpoints/changeformer_levir.pth
CONFIDENCE_THRESHOLD=0.5
PATCH_SIZE=256

# API
API_PORT=8080
LOG_LEVEL=INFO
